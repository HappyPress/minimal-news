{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "sunrise-orange",
					"color": "#FF6B1A",
					"name": "Sunrise Orange"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "Helvetica, Arial, sans-serif",
					"slug": "helvetica",
					"name": "Helvetica"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "14px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "18px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "24px",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "32px",
					"name": "2X Large"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1140px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"spacingSizes": [
				{
					"slug": "small",
					"size": "16px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "24px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "32px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "48px",
					"name": "Extra Large"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--helvetica)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--sunrise-orange)"
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sunrise-orange)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "24px",
						"right": "24px"
					}
				}
			}
		}
	}
}
